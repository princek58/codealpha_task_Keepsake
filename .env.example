# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/keepsake

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Network, Origins & Reverse Proxy
# TRUST_PROXY=1
# PUBLIC_URL=http://localhost:5000
# CLIENT_ORIGIN=http://localhost:5000
# ALLOWED_ORIGINS=http://localhost:5000,https://keepsake.onrender.com

# Media Storage Location (relative or absolute)
STORAGE_DIR=server/storage

# Demo Mode & Auto-Recovery (recommended on free tier)
# DEMO_MODE=true
# SEED_DEMO_ON_BOOT=true
# RECONCILE_STORAGE_ON_BOOT=true

# Upload Payload Caps & Quotas
MAX_IMAGE_MB=20
MAX_VIDEO_MB=150
MAX_VIDEO_SECONDS=180
MAX_FILES_PER_REQUEST=10
MAX_ITEMS_PER_MOMENT=20
MAX_ITEMS_PER_ALBUM=500
USER_QUOTA_MB=500
VIDEO_CONCURRENCY=1

# External Media Ingest (Optional - only needed to re-fetch raw stock media from Pexels)
# PEXELS_API_KEY=your_key_here
