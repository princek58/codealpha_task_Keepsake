{
  "name": "keepsake",
  "version": "1.0.0",
  "description": "A memory-keeping social web app",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "test": "jest --testPathIgnorePatterns=\"/client/\" --runInBand --detectOpenHandles --forceExit",
    "test:client": "jest --testMatch=\"**/client/tests/**/*.test.js\" --runInBand --detectOpenHandles --forceExit",
    "test:all": "npm test && npm run test:client",
    "test:e2e": "node scripts/e2e.js",
    "test:privacy": "node scripts/privacy-audit.js",
    "test:a11y": "node scripts/a11y.js",
    "audit:tokens": "node scripts/audit-tokens.js",
    "audit:contrast": "node scripts/audit-contrast.js",
    "verify:responsive": "node scripts/verify-responsive.js",
    "seed": "node scripts/seed.js",
    "demo": "node scripts/demo.js",
    "verify:all": "node scripts/verify_all.js"
  },
  "keywords": [
    "social",
    "express",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "axe-core": "^4.14.0",
    "babel-jest": "^30.5.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
