{
  "name": "bloomly",
  "version": "1.0.0",
  "description": "A cozy social media web app where little moments bloom",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "test": "jest --testPathIgnorePatterns=\"/client/\" --runInBand --detectOpenHandles --forceExit",
    "test:client": "jest --testMatch=\"**/client/tests/**/*.test.js\" --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "node scripts/e2e_runner.js",
    "audit:tokens": "node scripts/audit_tokens.js",
    "seed": "node scripts/seed.js",
    "verify:all": "node scripts/verify_all.js"
  },
  "keywords": [
    "social",
    "express",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
